// Coffres et menaces.
// Règles officielles (encyclopédie « Coffres ») :
//  - un coffre ne fait RIEN tant qu'il a 100 % de ses PV ;
//  - une fois touché : il se soigne, se protège, puis attaque une entité au hasard à sa portée ;
//  - coffre en bois 2 000 PV / force 500, fer 5 000 / 1 000, diamant 20 000 / 2 000.
// Avec ~650 PV, un coffre réveillé nous tue en 1 à 3 tours : on ne le touche jamais,
// sauf si on peut l'achever dans le tour (récompense : 30 000 à 3 500 000 habs).
// Dépend de lib/items.leek et de canHitFrom/launchAllows (lib/planner.leek).

function isChest(entity) {
    return getType(entity) == ENTITY_CHEST;
}

function isAwakeChest(entity) {
    return isChest(entity) && getLife(entity) < getTotalLife(entity);
}

function aliveChests() {
    return arrayFilter(getAliveEnemies(), isChest);
}

// Rayon (distance de Manhattan, estimation prudente) d'une zone d'effet.
function areaRadius(area) {
    if (area == AREA_CIRCLE_1 || area == AREA_X_1) return area == AREA_X_1 ? 2 : 1;
    if (area == AREA_CIRCLE_2 || area == AREA_PLUS_2 || area == AREA_SQUARE_1) return 2;
    if (area == AREA_CIRCLE_3 || area == AREA_PLUS_3) return 3;
    if (area == AREA_X_2 || area == AREA_SQUARE_2) return 4;
    if (area == AREA_X_3) return 6;
    return 0; // AREA_POINT et zones spéciales
}

// Un tir zone sur `targetCell` toucherait-il un coffre endormi ? (on ne doit pas le réveiller)
function wouldWakeChest(data, targetCell) {
    var radius = areaRadius(data[I_AREA]);
    if (radius == 0) return false;
    for (var chest in aliveChests()) {
        if (!isAwakeChest(chest) && getCellDistance(getCell(chest), targetCell) <= radius) return true;
    }
    return false;
}

// Dégâts qu'on risque de subir sur `cell` de la part des coffres réveillés (estimation haute).
function chestDangerAt(cell) {
    var danger = 0;
    for (var chest in aliveChests()) {
        if (!isAwakeChest(chest)) continue;
        var from = getCell(chest);
        var strength = getStrength(chest);
        for (var chip in getChips(chest)) {
            var data = CHIP_DATA[chip];
            if (data == null || data[I_DMG] <= 0) continue;
            // Portée élargie du rayon de zone : il peut viser une case voisine et nous toucher.
            var d = getCellDistance(from, cell);
            var radius = areaRadius(data[I_AREA]);
            if (d < data[I_MIN] - radius || d > data[I_MAX] + radius) continue;
            if (data[I_LOS] && !lineOfSight(from, cell, getEntity())) continue;
            danger += expectedDamage(data, getEntity(), strength);
        }
    }
    return danger;
}

// Coffre qu'on peut achever ce tour : [coffre, attaque] ou null.
function finishableChest() {
    for (var chest in aliveChests()) {
        var attack = chooseAttackCell(chest);
        if (attack != null && attack[2][1] >= getLife(chest)) return [chest, attack];
    }
    return null;
}

// ---------- Portée d'un adversaire ----------

// Portée max de ses attaques (armes et puces offensives).
function attackRange(entity) {
    var range = 0;
    for (var w in getWeapons(entity)) {
        var wd = WEAPON_DATA[w];
        if (wd != null && wd[I_DMG] > 0) range = max(range, wd[I_MAX] + areaRadius(wd[I_AREA]));
    }
    for (var c in getChips(entity)) {
        var cd = CHIP_DATA[c];
        if (cd != null && cd[I_DMG] > 0) range = max(range, cd[I_MAX] + areaRadius(cd[I_AREA]));
    }
    return range;
}

// L'adversaire peut-il frapper `cell` à son prochain tour (déplacement + portée) ?
function enemyCanReach(enemy, cell) {
    return getCellDistance(getCell(enemy), cell) <= getTotalMP(enemy) + attackRange(enemy);
}

// L'adversaire va-t-il probablement nous frapper à son prochain tour ? Plus strict que
// enemyCanReach (marge de 2 cases) : un adversaire tout juste à la limite de portée attend
// souvent. Sert à déclencher les boucliers au bon moment (combat 54967129 : boucliers lancés
// à 15 cases au tour 4, expirés au contact au tour 6, défaite à 30 PV près).
function enemyLikelyAttacks(enemy, cell) {
    return getCellDistance(getCell(enemy), cell) <= getTotalMP(enemy) + attackRange(enemy) - 2;
}

// Le combat commence-t-il d'ici un tour ? (pour les buffs de plusieurs tours, ex. motivation)
function combatSoon(enemy) {
    var reach = max(attackRange(enemy), attackRange(getEntity()));
    return getCellDistance(getCell(enemy), getCell()) <= getTotalMP() + getTotalMP(enemy) + reach;
}
