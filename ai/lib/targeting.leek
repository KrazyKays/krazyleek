// Choix de la cible : uniquement les vrais adversaires.
//  - jamais les coffres (lib/threat.leek : un coffre n'est attaqué que si on peut l'achever) ;
//  - les invocations (bulbes) seulement s'il ne reste aucun poireau adverse
//    (combat 54977534 : poursuite d'un bulbe de 90 PV pendant que le poireau adverse nous tuait).

// Plus le score est bas, plus la cible est prioritaire : PV faibles puis proximité.
function targetScore(enemy) {
    return getLife(enemy) + distanceTo(enemy) * 10;
}

function chooseTarget() {
    var best = null;
    var bestScore = 0;
    var bestSummon = null;
    var bestSummonScore = 0;
    for (var enemy in getAliveEnemies()) {
        if (isChest(enemy)) continue;
        var score = targetScore(enemy);
        if (isSummon(enemy)) {
            if (bestSummon == null || score < bestSummonScore) {
                bestSummon = enemy;
                bestSummonScore = score;
            }
            continue;
        }
        if (best == null || score < bestScore) {
            best = enemy;
            bestScore = score;
        }
    }
    if (best == null) return bestSummon;
    // Équipe : suivre la cible annoncée par un coéquipier si elle n'est pas beaucoup moins bonne.
    var focus = announcedTarget();
    if (focus != null && focus != best && targetScore(focus) <= bestScore + 200) return focus;
    return best;
}

// Cible inattaquable ce tour (souvent : poireau adverse retranché derrière ses bulbes, combat
// 54983936) → attaquer le meilleur autre ennemi atteignable (bulbe, autre poireau), en priorité
// celui qu'on peut tuer. Renvoie [ennemi, attaque] ou null. Jamais un coffre.
function fallbackAttack(mainTarget) {
    // Budget d'opérations : seulement les 3 ennemis les plus proches à portée (déplacement + portée).
    var reach = getMP() + attackRange(getEntity());
    var candidates = [];
    for (var enemy in getAliveEnemies()) {
        if (enemy == mainTarget || isChest(enemy)) continue;
        var d = distanceTo(enemy);
        if (d <= reach) push(candidates, [d, enemy]);
    }
    candidates = arraySort(candidates, function(a, b) { return a[0] - b[0]; });
    var best = null;
    var bestScore = 0;
    var tried = 0;
    for (var entry in candidates) {
        if (tried++ >= 3) break;
        var enemy = entry[1];
        var attack = chooseAttackCell(enemy);
        if (attack == null || attack[2][1] <= 0) continue;
        var score = attack[2][0]; // score du plan (kill = PV + 1000)
        if (best == null || score > bestScore) {
            best = [enemy, attack];
            bestScore = score;
        }
    }
    return best;
}
