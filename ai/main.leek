// =============================================================
// krazyKlick — IA principale (point d'entrée)
// IA générique « planificateur » : elle lit l'équipement réellement porté et les données
// officielles (lib/items.leek), choisit la case et la combinaison d'attaques qui font le plus
// de dégâts ce tour, puis se met à couvert avec les PM restants.
// Hors de portée : marche vers la position d'attaque la plus proche (contourne les murs).
// Coffres : jamais touchés (ni directement ni par une zone), évités s'ils sont réveillés,
// achevés seulement si c'est possible dans le tour.
// =============================================================
include("lib/items.leek");
include("lib/utils.leek");
include("lib/chips.leek");
include("lib/threat.leek");
include("lib/targeting.leek");
include("lib/planner.leek");
include("lib/survival.leek");
include("lib/movement.leek");

var target = chooseTarget();

if (target != null) {
    var attack = chooseAttackCell(target);
    var attackTarget = target;

    // Si on ne tue pas l'adversaire ce tour, achever un coffre rapporte gros.
    if (attack == null || attack[2][1] < getLife(target)) {
        var chestKill = finishableChest();
        if (chestKill != null) {
            attackTarget = chestKill[0];
            attack = chestKill[1];
        }
    }

    // Hors de portée : marcher vers une position d'attaque, puis réévaluer avec les PM restants.
    if (attack == null) {
        if (combatSoon(target)) tryChipSelf(CHIP_LEATHER_BOOTS); // +2 PM pour atteindre une position d'attaque
        approachAttackPosition(target);
        attack = chooseAttackCell(target);
    }

    var attacked = false;
    // Potentiel calculé avant d'attaquer (les recharges changent ensuite).
    var potential = potentialDamage(target);
    debug("[plan] tour " + getTurn() + " cible " + getName(attackTarget) + " : "
        + (attack == null ? "aucune attaque possible" : "case " + attack[0] + ", dégâts prévus " + round(attack[2][1])));
    if (attack != null) {
        if (attack[0] != getCell()) moveTowardCell(attack[0]);
        if (attack[0] != getCell()) debugW("[plan] case " + attack[0] + " non atteinte, reste en " + getCell());
        executePlan(attack[2], attackTarget);
        attacked = true;
    }

    // Après avoir frappé : si l'attaque était faible (< 60 % du potentiel), avancer vers une
    // meilleure position ; sinon se replier intelligemment. Jamais de repli sans attaque.
    if (attacked && isAlive(target)) {
        if (attackTarget == target && attack[2][1] < potential * 0.6) {
            advanceTowardStrongPositions(target);
        } else {
            retreatFrom(target);
        }
    }
    // PT restants : soins, puis motivation / boucliers s'ils serviront (depuis la case finale).
    healIfNeeded();
    if (isAlive(target)) useLeftoverSupport(target);
}

logOperations("fin du tour");
