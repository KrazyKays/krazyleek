// Déplacements : approche à couvert et repli.
// Dépend de lib/planner.leek (reachableCells) et lib/threat.leek (chestDangerAt).

// L'ennemi a-t-il une ligne de vue sur cette case ?
function exposedTo(cell, enemy) {
    return lineOfSight(getCell(enemy), cell, getEntity());
}

// Dégâts moyens de base par PT d'un objet.
function damagePerTP(data) {
    return data[I_DMG] / data[I_COST];
}

// Cases depuis lesquelles nos attaques toucheraient la cible (calcul officiel du jeu :
// portée, alignement, ligne de vue). ~25 000 opérations par objet.
// minRatio : ne garder que les objets dont les dégâts/PT valent au moins cette fraction
// du meilleur objet (0 = tous ; 0,5 = écarte l'étincelle, faible mais sans ligne de vue).
function attackPositions(target, minRatio) {
    var bestDpt = 0;
    for (var w in getWeapons()) {
        var wd = WEAPON_DATA[w];
        if (wd != null && wd[I_DMG] > 0) bestDpt = max(bestDpt, damagePerTP(wd));
    }
    for (var c in getChips()) {
        var cd = CHIP_DATA[c];
        if (cd != null && cd[I_DMG] > 0) bestDpt = max(bestDpt, damagePerTP(cd));
    }
    var cells = [];
    for (var w in getWeapons()) {
        var wd = WEAPON_DATA[w];
        if (wd != null && wd[I_DMG] > 0 && damagePerTP(wd) >= bestDpt * minRatio) {
            cells = arrayConcat(cells, getCellsToUseWeapon(w, target));
        }
    }
    for (var c in getChips()) {
        var cd = CHIP_DATA[c];
        if (cd != null && cd[I_DMG] > 0 && damagePerTP(cd) >= bestDpt * minRatio) {
            cells = arrayConcat(cells, getCellsToUseChip(c, target));
        }
    }
    return cells;
}

// Attaque faible ce tour (ex. étincelle seule derrière un mur) : utiliser les PM restants
// pour se rapprocher d'une position d'où nos attaques fortes porteront au tour suivant
// (combat 54966999 : 60 tours d'étincelles immobiles contre un adversaire qui se soignait).
function advanceTowardStrongPositions(target) {
    if (getMP() <= 0) return;
    var cells = attackPositions(target, 0.5);
    if (count(cells) > 0) moveTowardCells(cells);
}

// ---------- Anti-boucle ----------
// Historique des cases de fin de tour et dernier tour où l'on a infligé des dégâts.
global POS_HISTORY = [];
global LAST_DAMAGE_TURN = 0;

// À appeler en fin de tour (main.leek).
function recordTurn(dealtDamage) {
    push(POS_HISTORY, getCell());
    if (dealtDamage) LAST_DAMAGE_TURN = getTurn();
}

// Coincé dans une boucle : 3 tours sans dégâts et retour sur une case d'il y a 2 tours
// (combat 54979521 : 56 tours d'allers-retours 257 ↔ 327 à 7 cases, nul à 4 PV près).
function isStuck() {
    var n = count(POS_HISTORY);
    if (n < 4 || getTurn() - LAST_DAMAGE_TURN < 3) return false;
    return POS_HISTORY[n - 1] == POS_HISTORY[n - 3] || POS_HISTORY[n - 2] == POS_HISTORY[n - 4];
}

// Duel d'approche : celui qui entre le premier dans la portée de l'autre prend la première salve
// (combat 54991303, pistolet contre pistolet : avancé à 10 cases = sa portée + PM, il tire en premier,
// défaite 51–100). Si aucune attaque n'est possible ce tour, s'arrêter juste hors de sa portée ;
// il doit alors entrer dans la nôtre pour nous toucher. Seulement si notre portée + PM dépasse la sienne
// (sinon un tireur à longue portée nous pilonnerait de loin). L'anti-boucle (isStuck) relance l'assaut
// si les deux camps attendent.
function holdOutsideReach(target) {
    if (attackRange(getEntity()) + getMP() <= attackRange(target)) return false;
    if (!enemyCanReach(target, getCell()) && getCellDistance(getCell(), getCell(target))
            <= getTotalMP(target) + attackRange(target) + 1) {
        return true; // déjà à la bonne distance : ne pas bouger
    }
    var targetCell = getCell(target);
    var best = null;
    var bestDist = 0;
    for (var entry in reachableCells(getMP())) {
        if (enemyCanReach(target, entry[0])) continue;
        var d = getCellDistance(entry[0], targetCell) * 10 + entry[1];
        if (best == null || d < bestDist) {
            best = entry[0];
            bestDist = d;
        }
    }
    if (best == null) return false; // aucune case sûre : approche normale
    debug("[move] on attend hors de sa portée (case " + best + ")");
    if (best != getCell()) moveTowardCell(best);
    return true;
}

// Aucune attaque possible ce tour : marcher (vrai chemin du jeu, qui contourne les murs) vers la
// position d'attaque la plus proche. Pas de calcul « à vol d'oiseau » : il fait tourner en rond
// autour des murs (combat 54979521).
function approachAttackPosition(target) {
    if (isStuck()) {
        debugW("[move] boucle détectée : on fonce sur l'adversaire");
        moveToward(target);
        return;
    }
    if (holdOutsideReach(target)) return;
    var cells = attackPositions(target, 0);
    if (count(cells) > 0) {
        moveTowardCells(cells);
    } else {
        moveToward(target);
    }
}

// Après l'attaque : se replier seulement si c'est utile, sans perdre l'initiative.
// Priorités pour chaque case atteignable (case actuelle incluse) :
//  1. hors de portée de l'adversaire à son prochain tour (+100) ;
//  2. assez proche pour pouvoir encore attaquer au tour suivant (+50) ;
//  3. hors de sa ligne de vue (+10), loin des coffres réveillés, peu de PM dépensés.
// Si l'adversaire nous atteint de partout, on reste à portée de tir au lieu de fuir
// (combat 54966751 : fuir 3 cases puis revenir = une attaque tous les deux tours).
function retreatScore(cell, pathLen, target, myReach) {
    var targetCell = getCell(target);
    var score = 0;
    if (!enemyCanReach(target, cell)) score += 100;
    if (getCellDistance(cell, targetCell) <= myReach) score += 50;
    if (!exposedTo(cell, target)) score += 10;
    score -= chestDangerAt(cell) / 5;
    score -= otherThreats(cell, target) * 30; // équipe : autres adversaires à portée (0 en solo)
    score -= pathLen * 0.5;
    return score;
}

function retreatFrom(target) {
    if (getMP() <= 0) return;
    if (isStuck()) return; // en boucle : ne pas reculer, rester au contact
    var myReach = attackRange(getEntity()) + getTotalMP();
    var best = null;
    var bestScore = 0;
    for (var entry in reachableCells(getMP())) {
        var score = retreatScore(entry[0], entry[1], target, myReach);
        if (best == null || score > bestScore) {
            best = entry[0];
            bestScore = score;
        }
    }
    if (best != null && best != getCell()) moveTowardCell(best);
}
