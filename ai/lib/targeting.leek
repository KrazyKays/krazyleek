// Choix de la cible : uniquement les vrais adversaires.
//  - jamais les coffres (lib/threat.leek : un coffre n'est attaqué que si on peut l'achever) ;
//  - les invocations (bulbes) seulement s'il ne reste aucun poireau adverse
//    (combat 54977534 : poursuite d'un bulbe de 90 PV pendant que le poireau adverse nous tuait).

// Plus le score est bas, plus la cible est prioritaire : PV faibles puis proximité.
function targetScore(enemy) {
    return getLife(enemy) + distanceTo(enemy) * 10;
}

function chooseTarget() {
    var best = null;
    var bestScore = 0;
    var bestSummon = null;
    var bestSummonScore = 0;
    for (var enemy in getAliveEnemies()) {
        if (isChest(enemy)) continue;
        var score = targetScore(enemy);
        if (isSummon(enemy)) {
            if (bestSummon == null || score < bestSummonScore) {
                bestSummon = enemy;
                bestSummonScore = score;
            }
            continue;
        }
        if (best == null || score < bestScore) {
            best = enemy;
            bestScore = score;
        }
    }
    if (best == null) return bestSummon;
    // Équipe : suivre la cible annoncée par un coéquipier si elle n'est pas beaucoup moins bonne.
    var focus = announcedTarget();
    if (focus != null && focus != best && targetScore(focus) <= bestScore + 200) return focus;
    return best;
}
