// Attaques : arme puis puces offensives.

// Équipe l'arme voulue si on ne la tient pas déjà (coûte 1 PT).
function ensureWeapon(weapon) {
    if (getWeapon() != weapon && inArray(getWeapons(), weapon)) {
        setWeapon(weapon);
    }
}

// Tire tant que l'arme est utilisable et que la cible est vivante.
function shootUntilEmpty(target) {
    var shots = 0;
    while (shots < 10 && isAlive(target) && canUseWeapon(target)) {
        var result = useWeapon(target);
        if (result != USE_SUCCESS && result != USE_CRITICAL) {
            break;
        }
        shots++;
    }
    return shots;
}

// La cible est-elle attaquable ce tour depuis la position actuelle ?
function canAttackNow(target) {
    return canUseWeapon(target) || canUseChip(CHIP_PEBBLE, target) || canUseChip(CHIP_SPARK, target);
}

// Séquence offensive : caillou, pistolet, puis étincelle avec les PT restants.
function attackSequence(target) {
    tryChip(CHIP_PEBBLE, target);
    shootUntilEmpty(target);
    spamChip(CHIP_SPARK, target, 5);
}
