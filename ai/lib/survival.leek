// Soins, défense et buffs de PT avec les PT restants.
// Dépend de lib/items.leek et lib/chips.leek.

// Soigne avec les puces de soin équipées tant que les PV manquants le justifient.
function healIfNeeded() {
    var mult = 1 + getWisdom() / 100;
    for (var chip in getChips()) {
        var data = CHIP_DATA[chip];
        if (data == null || data[I_HEAL] <= 0) continue;
        // On ne soigne que si le soin moyen ne déborde pas des PV max.
        if (getTotalLife() - getLife() >= data[I_HEAL] * mult) {
            tryChipSelf(chip);
        }
    }
}

// Puces de soutien sur soi avec les PT restants, seulement quand elles serviront :
//  - motivation (+PT pendant 3 tours) : si le combat commence d'ici un tour ;
//  - boucliers (2–3 tours) : si l'adversaire va probablement nous frapper à son prochain tour.
// À appeler APRÈS le repli (la case finale compte pour les boucliers).
global BUFF_CHIPS = [CHIP_MOTIVATION];
global DEFENSE_CHIPS = [CHIP_SHIELD, CHIP_HELMET, CHIP_WALL];

function useLeftoverSupport(enemy) {
    if (combatSoon(enemy)) {
        for (var chip in BUFF_CHIPS) {
            if (inArray(getChips(), chip)) tryChipSelf(chip);
        }
    }
    if (enemyLikelyAttacks(enemy, getCell())) {
        for (var chip in DEFENSE_CHIPS) {
            if (inArray(getChips(), chip)) tryChipSelf(chip);
        }
    }
}
